  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 73070efaa1016fc47a3b4023d9a33be2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  readme: "This GameObject connects an XRI player prefab to Ubiq through Ubiq's Avatar
    Input system. \n\nUbiq uses this input to drive the avatar that appears on this
    machine (the 'local' avatar). The local avatar then sends these inputs over the
    network so that the movements of this avatar are in sync with its copies on other
    user's machines (where the copies are 'remote' avatars).\n\nNormally you would
    slot the visuals for the user's body in among the player prefab hierarchy. With
    Ubiq, we instead recommend that you create a custom avatar prefab and add it
    to Ubiq's Avatar system (see the Avatar Manager). This way you can use the same
    avatar for local and remote users, and easily change avatar at runtime."
